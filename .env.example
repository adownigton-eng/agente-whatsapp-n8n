# Copie este arquivo para .env e preencha os valores.
# Use senhas fortes. Para gerar uma chave aleatoria:
#   openssl rand -hex 24
# ou, no PowerShell:
#   -join ((48..57)+(97..122) | Get-Random -Count 32 | % {[char]$_})

# ---------- POSTGRES (banco do n8n e do agente) ----------
POSTGRES_USER=agente
POSTGRES_PASSWORD=
POSTGRES_DB=agente

# ---------- WAHA (conexao com o WhatsApp) ----------
# Login do dashboard em http://localhost:3000/dashboard
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=

# Chave da API do WAHA. O n8n usa a mesma chave para enviar mensagens.
WHATSAPP_API_KEY=
